# Terraform working directory
.terraform/
.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Sensitive variable files
*.tfvars
*.tfvars.json

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform lock file
.terraform.lock.hcl

# Terraform plan files
*.tfplan
planout

# CLI config
.terraformrc
terraform.rc

# Graph files
*.dot
