# Terraform working directory (providers, plugins, etc.)
.terraform/
.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform lock file (can cause merge conflicts and bloat)
.terraform.lock.hcl

# Crash logs
crash.log
crash.*.log

# Sensitive variable files
*.tfvars
*.tfvars.json

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan files (can be huge)
*.tfplan
planout

# CLI config
.terraformrc
terraform.rc

# Graph files
*.dot
